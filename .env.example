# Copy to .env; never commit real values. Use a URL-safe local password.
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://floodlens:replace_with_a_long_random_password@localhost:5432/floodlens
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# AWS credentials are resolved by the standard AWS profile / IAM role chain.
AWS_REGION=ap-south-1
S3_BUCKET=
